<Project>
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)runtimes/win-x64/native/security_native.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)runtimes/win-x64/native/security_native.dll')"
          Link="security_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
